{
  "name": "bim-audit-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "format": "prettier -w .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:schema-tabelas": "npx tsx scripts/run-schema-tabelas.ts",
    "db:drop-legadas": "npx tsx scripts/run-drop-tabelas-legadas.ts",
    "db:fix-import-usuarios": "npx tsx scripts/run-fix-dim-usuarios-import.ts",
    "db:fix-import-checklist": "npx tsx scripts/run-fix-checklist-import.ts",
    "db:fix-import-fato-auditorias": "npx tsx scripts/run-fix-fato-auditorias-import.ts",
    "db:import-auditoria-sql": "npx tsx scripts/run-import-auditoria-sql.ts",
    "db:insert-admin": "npx tsx scripts/run-insert-admin.ts",
    "db:csv-to-sql-usuarios": "npx tsx scripts/csv-to-sql-dim-usuarios.ts",
    "db:csv-to-sql-checklist": "npx tsx scripts/csv-to-sql-checklist-template.ts",
    "db:csv-to-sql-aplicabilidade": "npx tsx scripts/csv-to-sql-aplicabilidade-fases.ts",
    "db:csv-to-sql-fato-auditorias": "npx tsx scripts/csv-to-sql-fato-auditorias.ts",
    "db:csv-to-sql-fato-itens": "npx tsx scripts/csv-to-sql-fato-auditoria-itens.ts",
    "db:csv-to-sql-scores": "npx tsx scripts/csv-to-sql-scores-calculados.ts",
    "postinstall": "node -e \"if(process.env.DATABASE_URL){require('child_process').execSync('npm run db:generate',{stdio:'inherit'})}\"",
    "import": "node --experimental-strip-types scripts/import-spreadsheet.ts",
    "setup-storage": "npx tsx scripts/setup-storage-bucket.ts",
    "supabase:db-push": "supabase db push",
    "migrate:activity-logs": "npx tsx scripts/run-activity-logs-migration.ts",
    "migrate:outros-category": "npx tsx scripts/run-outros-category-migration.ts",
    "template:auditorias": "npx tsx scripts/generate-audit-import-template.ts public/template-migracao-auditorias.xlsx"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.57.1",
    "lightningcss-linux-x64-gnu": "1.30.2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.57.0",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "html2canvas-pro": "^1.6.7",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.575.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "react-is": "^19.2.4",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/debug": "^6.19.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/react": "19.2.14",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^6.1.0",
    "effect": "^3.19.19",
    "pg": "^8.18.0",
    "prettier": "^3.6.2",
    "prisma": "^6.16.1",
    "supabase": "^2.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
